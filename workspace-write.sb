(version 1)
(allow default)
(deny file-write*)
(allow file-write*
  (subpath (param "WORKSPACE"))
  (subpath "/private/tmp")
  (subpath "/tmp")
  (subpath "/dev")
  (regex #"^/private/var/folders/")
  (regex #"^/Users/[^/]+/Library/Caches/")
  (regex #"^/Users/[^/]+/\.cache/")
  (regex #"^/Users/[^/]+/\.cargo/")
  (regex #"^/Users/[^/]+/\.rustup/")
  (regex #"^/Users/[^/]+/\.bun/")
  (regex #"^/Users/[^/]+/\.npm/")
  (regex #"^/Users/[^/]+/\.local/share/uv/")
  (regex #"^/Users/[^/]+/Library/pnpm/"))
(deny file-write*
  (regex #"(^|/)\.git(/|$)"))
